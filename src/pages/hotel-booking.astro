---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Layout title="Hotel Booking - Delta Air Travel">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Book Your Hotel</h1>
        <p class="text-xl text-blue-100">Get up to 15% discount on hotel bookings worldwide</p>
      </div>
    </section>

    <!-- Service Card -->
    <section class="py-8 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-6 shadow-md mb-8">
          <div class="flex justify-between items-start">
            <div>
              <h2 class="text-2xl font-bold text-blue-900">Hotel Reservations</h2>
              <p class="text-gray-700 mt-2">Reserve luxury hotels, budget accommodations, and everything in between at the best rates.</p>
            </div>
            <span class="bg-blue-600 text-white px-4 py-2 rounded-full font-semibold">Save 15%</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Form -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <BookingForm serviceType="hotel" />
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">Why Choose Our Hotels?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">🏨</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">Wide Selection</h3>
            <p class="text-gray-700">Choose from millions of hotels worldwide, from luxury resorts to budget-friendly stays.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">💰</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">Best Rates</h3>
            <p class="text-gray-700">Compare prices from all major hotel chains and booking platforms to get the best deal.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">🔒</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">Secure Booking</h3>
            <p class="text-gray-700">Your booking is secure and confirmed directly with the hotel.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Hotel Categories -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">Hotel Categories</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">⭐ Luxury Hotels</h3>
            <p class="text-gray-700">Experience premium accommodations with world-class amenities and services.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">⭐⭐ Mid-Range Hotels</h3>
            <p class="text-gray-700">Comfortable and convenient stays with good amenities at reasonable prices.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">⭐⭐⭐ Budget Hotels</h3>
            <p class="text-gray-700">Affordable and clean accommodations perfect for budget-conscious travelers.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🏡 Vacation Rentals</h3>
            <p class="text-gray-700">Unique accommodations including apartments, villas, and country homes.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
