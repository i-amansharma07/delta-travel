---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Layout title="Flight Booking - Delta Air Travel">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Book Your Flight</h1>
        <p class="text-xl text-blue-100">Get up to 20% discount on flight bookings</p>
      </div>
    </section>

    <!-- Service Card -->
    <section class="py-8 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-6 shadow-md mb-8">
          <div class="flex justify-between items-start">
            <div>
              <h2 class="text-2xl font-bold text-blue-900">Flight Booking</h2>
              <p class="text-gray-700 mt-2">Book domestic and international flights with the best rates and exclusive discounts.</p>
            </div>
            <span class="bg-blue-600 text-white px-4 py-2 rounded-full font-semibold">Save 20%</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Form -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <BookingForm serviceType="flight" />
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">Why Book With Us?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">✓</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">Best Price Guarantee</h3>
            <p class="text-gray-700">We guarantee the lowest fares for your chosen flights or we'll match any lower price.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">✓</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">Easy Cancellation</h3>
            <p class="text-gray-700">Flexible cancellation policies with quick refunds to your original payment method.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">✓</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">24/7 Support</h3>
            <p class="text-gray-700">Our dedicated support team is available around the clock to help you.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">How It Works</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-4 font-bold">1</div>
            <h3 class="font-bold text-blue-900 mb-2">Search Flights</h3>
            <p class="text-sm text-gray-700">Enter your travel dates and cities</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-4 font-bold">2</div>
            <h3 class="font-bold text-blue-900 mb-2">Compare Options</h3>
            <p class="text-sm text-gray-700">View all available flights and prices</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-4 font-bold">3</div>
            <h3 class="font-bold text-blue-900 mb-2">Select Flight</h3>
            <p class="text-sm text-gray-700">Choose your preferred flight and fare</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-4 font-bold">4</div>
            <h3 class="font-bold text-blue-900 mb-2">Confirm Booking</h3>
            <p class="text-sm text-gray-700">Get your confirmation and boarding pass</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
