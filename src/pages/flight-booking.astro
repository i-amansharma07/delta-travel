---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingForm from "../components/BookingForm.astro";
import { flightBookingConstants } from "../constants/flight_booking_constants";
---

<Layout title="Flight Booking - Book Flights at Best Prices - Delta Air Travel">
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="relative bg-slate-900 text-white overflow-hidden">
            <div class="absolute inset-0 opacity-50">
                <img
                    src="/images/airplane-takeoff.jpg"
                    alt="Modern aircraft taking off"
                    class="w-full h-full object-cover"
                />
            </div>
            <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/85 to-slate-900/50"></div>

            <div class="relative z-10 max-w-container mx-auto px-4 py-section-lg text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">
                    Book Your Flight Today
                </h1>
                <p class="text-xl text-slate-200 mb-4">
                    Get up to 20% discount on flights worldwide
                </p>
                <div class="inline-block bg-accent-500/10 border border-accent-500/30 rounded-lg px-4 py-2">
                    <span class="text-accent-400 font-semibold">
                        ✓ Best Price Guarantee
                    </span>
                </div>
            </div>
        </section>

        <!-- Main Booking Form -->
        <section class="py-section-lg px-4 bg-white">
            <BookingForm serviceType="flight" />
        </section>

        <!-- Why Choose Us -->
        <section class="py-section-lg px-4 bg-slate-50">
            <div class="max-w-container mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12 text-center">
                    Why Book Flights With Us?
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="bg-white border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">💰</div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">
                            Best Price Guarantee
                        </h3>
                        <p class="text-slate-600">
                            We guarantee the lowest fares for your chosen
                            flights. If you find a lower price, we'll match it.
                        </p>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">🔄</div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">
                            Flexible Changes
                        </h3>
                        <p class="text-slate-600">
                            Change your flight dates, times, or destinations
                            with free changes up to 24 hours before departure.
                        </p>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">🛡️</div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">
                            Travel Insurance
                        </h3>
                        <p class="text-slate-600">
                            Optional travel insurance protects your investment
                            against unexpected cancellations and emergencies.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section class="py-section-lg px-4 bg-white">
            <div class="max-w-container mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12 text-center">
                    Our Booking Process
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-16 h-16 bg-accent-600 text-white rounded-full font-bold text-xl mb-4">
                            1
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">
                            Tell Us Where
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Enter departure, destination, and travel dates
                        </p>
                    </div>

                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-16 h-16 bg-accent-600 text-white rounded-full font-bold text-xl mb-4">
                            2
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">
                            We Search
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Compare thousands of flights instantly
                        </p>
                    </div>

                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-16 h-16 bg-accent-600 text-white rounded-full font-bold text-xl mb-4">
                            3
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">
                            You Pick
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Choose your preferred flight and fare
                        </p>
                    </div>

                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-16 h-16 bg-accent-600 text-white rounded-full font-bold text-xl mb-4">
                            4
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">
                            Confirmed!
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Get instant confirmation and boarding pass
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Popular Routes -->
        <section class="py-section-lg px-4 bg-slate-50">
            <div class="max-w-container mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12 text-center">
                    Popular Routes
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div class="bg-white border border-slate-200 rounded-lg p-4 hover:border-accent-500 transition cursor-pointer">
                        <p class="font-semibold text-slate-900">
                            New York → Los Angeles
                        </p>
                        <p class="text-sm text-slate-600">From $129</p>
                    </div>
                    <div class="bg-white border border-slate-200 rounded-lg p-4 hover:border-accent-500 transition cursor-pointer">
                        <p class="font-semibold text-slate-900">
                            Chicago → Miami
                        </p>
                        <p class="text-sm text-slate-600">From $89</p>
                    </div>
                    <div class="bg-white border border-slate-200 rounded-lg p-4 hover:border-accent-500 transition cursor-pointer">
                        <p class="font-semibold text-slate-900">
                            Boston → Las Vegas
                        </p>
                        <p class="text-sm text-slate-600">From $99</p>
                    </div>
                    <div class="bg-white border border-slate-200 rounded-lg p-4 hover:border-accent-500 transition cursor-pointer">
                        <p class="font-semibold text-slate-900">
                            San Francisco → Seattle
                        </p>
                        <p class="text-sm text-slate-600">From $79</p>
                    </div>
                    <div class="bg-white border border-slate-200 rounded-lg p-4 hover:border-accent-500 transition cursor-pointer">
                        <p class="font-semibold text-slate-900">
                            Denver → Phoenix
                        </p>
                        <p class="text-sm text-slate-600">From $69</p>
                    </div>
                    <div class="bg-white border border-slate-200 rounded-lg p-4 hover:border-accent-500 transition cursor-pointer">
                        <p class="font-semibold text-slate-900">
                            Atlanta → Orlando
                        </p>
                        <p class="text-sm text-slate-600">From $59</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-section-lg px-4 bg-slate-900 text-white">
            <div class="max-w-container mx-auto text-center">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">
                    Ready to Fly?
                </h2>
                <p class="text-lg text-slate-200 mb-8">
                    Get instant quotes on flights to anywhere in the world
                </p>
                <a
                    href="#flight-form"
                    class="inline-block bg-accent-600 hover:bg-accent-700 text-white font-semibold px-8 py-3 rounded-lg transition"
                >
                    Search Flights Now
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
