---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Blog - Delta Air Travel">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Travel Blog</h1>
        <p class="text-xl text-blue-100">Tips, Guides, and Stories from Travel Experts</p>
      </div>
    </section>

    <!-- Blog Posts -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <!-- Post 1 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-48 flex items-center justify-center">
              <span class="text-6xl">✈️</span>
            </div>
            <div class="p-6">
              <div class="flex items-center text-sm text-gray-600 mb-2">
                <span class="text-blue-600 font-semibold">Travel Tips</span>
                <span class="mx-2">•</span>
                <span>September 18, 2026</span>
              </div>
              <h3 class="text-xl font-bold text-blue-900 mb-3">10 Tips to Save Money on Flight Bookings</h3>
              <p class="text-gray-700 mb-4">Discover expert strategies to find the best flight deals and save money on your next trip.</p>
              <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">Read More →</a>
            </div>
          </article>

          <!-- Post 2 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-48 flex items-center justify-center">
              <span class="text-6xl">🏨</span>
            </div>
            <div class="p-6">
              <div class="flex items-center text-sm text-gray-600 mb-2">
                <span class="text-blue-600 font-semibold">Hotel Guide</span>
                <span class="mx-2">•</span>
                <span>September 15, 2026</span>
              </div>
              <h3 class="text-xl font-bold text-blue-900 mb-3">How to Choose the Perfect Hotel for Your Stay</h3>
              <p class="text-gray-700 mb-4">A complete guide to finding and booking the ideal hotel that matches your needs and budget.</p>
              <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">Read More →</a>
            </div>
          </article>

          <!-- Post 3 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-48 flex items-center justify-center">
              <span class="text-6xl">🚢</span>
            </div>
            <div class="p-6">
              <div class="flex items-center text-sm text-gray-600 mb-2">
                <span class="text-blue-600 font-semibold">Cruise Guide</span>
                <span class="mx-2">•</span>
                <span>September 12, 2026</span>
              </div>
              <h3 class="text-xl font-bold text-blue-900 mb-3">Everything You Need to Know Before Your First Cruise</h3>
              <p class="text-gray-700 mb-4">First-time cruise tips and guide to make your cruise vacation unforgettable.</p>
              <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">Read More →</a>
            </div>
          </article>

          <!-- Post 4 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-48 flex items-center justify-center">
              <span class="text-6xl">🌍</span>
            </div>
            <div class="p-6">
              <div class="flex items-center text-sm text-gray-600 mb-2">
                <span class="text-blue-600 font-semibold">Destination</span>
                <span class="mx-2">•</span>
                <span>September 10, 2026</span>
              </div>
              <h3 class="text-xl font-bold text-blue-900 mb-3">Top 5 Must-Visit Destinations in 2026</h3>
              <p class="text-gray-700 mb-4">Discover the most popular travel destinations and why you should visit them.</p>
              <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">Read More →</a>
            </div>
          </article>

          <!-- Post 5 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-48 flex items-center justify-center">
              <span class="text-6xl">📋</span>
            </div>
            <div class="p-6">
              <div class="flex items-center text-sm text-gray-600 mb-2">
                <span class="text-blue-600 font-semibold">Travel Essentials</span>
                <span class="mx-2">•</span>
                <span>September 8, 2026</span>
              </div>
              <h3 class="text-xl font-bold text-blue-900 mb-3">The Ultimate Travel Packing Checklist</h3>
              <p class="text-gray-700 mb-4">Never forget anything again with our comprehensive travel packing guide.</p>
              <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">Read More →</a>
            </div>
          </article>

          <!-- Post 6 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-48 flex items-center justify-center">
              <span class="text-6xl">💰</span>
            </div>
            <div class="p-6">
              <div class="flex items-center text-sm text-gray-600 mb-2">
                <span class="text-blue-600 font-semibold">Budget Travel</span>
                <span class="mx-2">•</span>
                <span>September 5, 2026</span>
              </div>
              <h3 class="text-xl font-bold text-blue-900 mb-3">Budget Travel Guide: Travel More for Less</h3>
              <p class="text-gray-700 mb-4">Learn how to travel on a budget without compromising on experiences.</p>
              <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">Read More →</a>
            </div>
          </article>
        </div>

        <!-- Load More -->
        <div class="text-center py-8">
          <button class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold">
            Load More Posts
          </button>
        </div>
      </div>
    </section>

    <!-- Newsletter Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-12 px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Subscribe to Our Newsletter</h2>
        <p class="text-blue-100 mb-6">Get travel tips, exclusive deals, and updates delivered to your inbox.</p>
        <form class="flex flex-col md:flex-row gap-3">
          <input type="email" placeholder="Enter your email" class="flex-1 px-4 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" />
          <button type="submit" class="bg-white text-blue-900 px-8 py-3 rounded-lg hover:bg-blue-100 transition-colors font-bold">
            Subscribe
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
