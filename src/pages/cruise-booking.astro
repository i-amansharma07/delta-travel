---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Layout title="Cruise Packages - Delta Air Travel">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Luxury Cruise Packages</h1>
        <p class="text-xl text-blue-100">Get up to 25% discount on amazing cruise vacations</p>
      </div>
    </section>

    <!-- Service Card -->
    <section class="py-8 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-6 shadow-md mb-8">
          <div class="flex justify-between items-start">
            <div>
              <h2 class="text-2xl font-bold text-blue-900">Cruise Packages</h2>
              <p class="text-gray-700 mt-2">Experience unforgettable cruise vacations with exclusive packages to Caribbean, Mediterranean, and beyond.</p>
            </div>
            <span class="bg-blue-600 text-white px-4 py-2 rounded-full font-semibold">Save 25%</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Form -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <BookingForm serviceType="cruise" />
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">Why Cruise With Us?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">🚢</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">Exclusive Deals</h3>
            <p class="text-gray-700">Access special cruise packages and promotions not available elsewhere.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">🌍</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">World-Class Lines</h3>
            <p class="text-gray-700">Partner with major cruise lines including Royal Caribbean, Carnival, Disney, and more.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <div class="text-3xl mb-3">✓</div>
            <h3 class="text-xl font-bold text-blue-900 mb-2">Flexibility</h3>
            <p class="text-gray-700">Flexible payment options and cancellation policies for peace of mind.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular Destinations -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">Popular Cruise Destinations</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🏝️ Caribbean</h3>
            <p class="text-gray-700">Tropical paradise with beautiful beaches and crystal-clear waters.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🏛️ Mediterranean</h3>
            <p class="text-gray-700">Explore historic cities, ancient ruins, and stunning coastal scenery.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-900 mb-2">❄️ Alaska</h3>
            <p class="text-gray-700">Witness glaciers, wildlife, and pristine nature in the Last Frontier.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🌅 European Rivers</h3>
            <p class="text-gray-700">Journey through charming European cities along scenic rivers.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🏝️ South Pacific</h3>
            <p class="text-gray-700">Experience island-hopping and tropical island escapes.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🌎 World Cruises</h3>
            <p class="text-gray-700">Epic multi-month voyages visiting multiple continents.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cruise Amenities -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">What's Included</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex items-start">
            <span class="text-2xl mr-4">✓</span>
            <div>
              <h3 class="font-bold text-blue-900 mb-1">Accommodation</h3>
              <p class="text-gray-700">Comfortable cabin with modern amenities</p>
            </div>
          </div>
          <div class="flex items-start">
            <span class="text-2xl mr-4">✓</span>
            <div>
              <h3 class="font-bold text-blue-900 mb-1">Meals</h3>
              <p class="text-gray-700">Multiple dining options and unlimited food</p>
            </div>
          </div>
          <div class="flex items-start">
            <span class="text-2xl mr-4">✓</span>
            <div>
              <h3 class="font-bold text-blue-900 mb-1">Entertainment</h3>
              <p class="text-gray-700">Shows, activities, and nightly entertainment</p>
            </div>
          </div>
          <div class="flex items-start">
            <span class="text-2xl mr-4">✓</span>
            <div>
              <h3 class="font-bold text-blue-900 mb-1">Excursions</h3>
              <p class="text-gray-700">Shore excursions at each port</p>
            </div>
          </div>
          <div class="flex items-start">
            <span class="text-2xl mr-4">✓</span>
            <div>
              <h3 class="font-bold text-blue-900 mb-1">Fitness</h3>
              <p class="text-gray-700">Gym, pools, and spa facilities</p>
            </div>
          </div>
          <div class="flex items-start">
            <span class="text-2xl mr-4">✓</span>
            <div>
              <h3 class="font-bold text-blue-900 mb-1">Service</h3>
              <p class="text-gray-700">World-class service and hospitality</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
