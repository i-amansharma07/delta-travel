---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { aboutUsConstants } from "../constants/about_us_constants";

function replacePhoneNumberWithLink(text) {
  const phoneNumber = '+1 800 258 1388';
  const link = `<a href="tel:${phoneNumber.replace(/\s/g, '')}" class="text-blue-600 hover:text-blue-800">${phoneNumber}</a>`;
  return text.replaceAll(phoneNumber, link);
}
---

<Layout title="About Us - Delta Air Travel">
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
            <div class="max-w-7xl mx-auto text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">
                    {aboutUsConstants.hero.title}
                </h1>
                <p class="text-xl text-blue-100">
                    {aboutUsConstants.hero.subtitle}
                </p>
            </div>
        </section>

        <!-- About Content -->
        <section class="py-12 px-4 bg-white">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold text-blue-900 mb-6">
                    {aboutUsConstants.whoWeAre.heading}
                </h2>
                {aboutUsConstants.whoWeAre.paragraphs.map((para) => (
                    <p class="text-gray-700 mb-4 leading-relaxed">
                        {para}
                    </p>
                ))}

                <h2 class="text-3xl font-bold text-blue-900 mb-6 mt-8">
                    {aboutUsConstants.mission.heading}
                </h2>
                <p class="text-gray-700 mb-4 leading-relaxed">
                    {aboutUsConstants.mission.description}
                </p>

                <h2 class="text-3xl font-bold text-blue-900 mb-6 mt-8">
                    {aboutUsConstants.whyChooseUs.heading}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                    {aboutUsConstants.whyChooseUs.cards.map((card) => (
                        <div class="bg-blue-50 p-6 rounded-lg">
                            <h3 class="text-xl font-bold text-blue-900 mb-3">
                                {card.emoji} {card.title}
                            </h3>
                            <p class="text-gray-700">
                                {card.description}
                            </p>
                        </div>
                    ))}
                </div>

                <h2 class="text-3xl font-bold text-blue-900 mb-6 mt-8">
                    {aboutUsConstants.ourServices.heading}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                    {aboutUsConstants.ourServices.services.map((service) => (
                        <div>
                            <h3 class="text-xl font-bold text-blue-900 mb-2">
                                {service.title}
                            </h3>
                            <p class="text-gray-700">
                                {service.description}
                            </p>
                        </div>
                    ))}
                </div>

                <!-- FAQ -->
                <div class="mt-10">
                    <h2 class="text-3xl font-bold text-blue-900 mb-6">
                        {aboutUsConstants.faq.heading}
                    </h2>
                    <div class="space-y-4">
                        {aboutUsConstants.faq.questions.map((faq) => (
                            <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
                                <summary class="font-bold text-blue-900 text-lg">
                                    {faq.question}
                                </summary>
                                <p class="text-gray-700 mt-4" set:html={replacePhoneNumberWithLink(faq.answer)} />
                            </details>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
