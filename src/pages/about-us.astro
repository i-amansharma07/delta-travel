---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="About Us - Delta Air Travel">
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
            <div class="max-w-7xl mx-auto text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    About Delta Air Travel
                </h1>
                <p class="text-xl text-blue-100">
                    Your Trusted Travel Partner for Over 15 Years
                </p>
            </div>
        </section>

        <!-- About Content -->
        <section class="py-12 px-4 bg-white">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold text-blue-900 mb-6">
                    Who We Are
                </h2>
                <p class="text-gray-700 mb-4 leading-relaxed">
                    Delta Air Travel is a leading travel booking service with
                    over 15 years of experience in the industry. We specialize
                    in providing affordable and reliable travel solutions for
                    flights, hotels, cruises, and comprehensive cancellation
                    support.
                </p>
                <p class="text-gray-700 mb-4 leading-relaxed">
                    Our mission is to make travel booking simple, transparent,
                    and accessible to everyone. We believe that travel should be
                    stress-free, which is why we've built our entire platform
                    around customer satisfaction and support.
                </p>

                <h2 class="text-3xl font-bold text-blue-900 mb-6 mt-8">
                    Our Mission
                </h2>
                <p class="text-gray-700 mb-4 leading-relaxed">
                    To provide world-class travel booking services with
                    competitive prices, transparent policies, and exceptional
                    customer support available 24/7.
                </p>

                <h2 class="text-3xl font-bold text-blue-900 mb-6 mt-8">
                    Why Choose Us?
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                    <div class="bg-blue-50 p-6 rounded-lg">
                        <h3 class="text-xl font-bold text-blue-900 mb-3">
                            ✓ 15+ Years Experience
                        </h3>
                        <p class="text-gray-700">
                            Trusted by thousands of customers worldwide with
                            proven expertise in travel bookings.
                        </p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-lg">
                        <h3 class="text-xl font-bold text-blue-900 mb-3">
                            ✓ Best Prices Guaranteed
                        </h3>
                        <p class="text-gray-700">
                            We offer competitive rates and exclusive discounts
                            up to 25% off on all travel services.
                        </p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-lg">
                        <h3 class="text-xl font-bold text-blue-900 mb-3">
                            ✓ 24/7 Customer Support
                        </h3>
                        <p class="text-gray-700">
                            Our dedicated support team is available round the
                            clock to assist with your travel needs.
                        </p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-lg">
                        <h3 class="text-xl font-bold text-blue-900 mb-3">
                            ✓ Quick Refunds
                        </h3>
                        <p class="text-gray-700">
                            Fast and hassle-free refund processing for cancelled
                            bookings.
                        </p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-lg">
                        <h3 class="text-xl font-bold text-blue-900 mb-3">
                            ✓ Easy Booking
                        </h3>
                        <p class="text-gray-700">
                            Simple and intuitive booking process that takes just
                            minutes to complete.
                        </p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-lg">
                        <h3 class="text-xl font-bold text-blue-900 mb-3">
                            ✓ Cancellation Support
                        </h3>
                        <p class="text-gray-700">
                            Comprehensive support for any cancellations or
                            changes to your bookings.
                        </p>
                    </div>
                </div>

                <h2 class="text-3xl font-bold text-blue-900 mb-6 mt-8">
                    Our Services
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                    <div>
                        <h3 class="text-xl font-bold text-blue-900 mb-2">
                            Flight Booking
                        </h3>
                        <p class="text-gray-700">
                            Book domestic and international flights with up to
                            20% discount.
                        </p>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-blue-900 mb-2">
                            Hotel Reservations
                        </h3>
                        <p class="text-gray-700">
                            Reserve hotels worldwide with up to 15% savings on
                            accommodation.
                        </p>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-blue-900 mb-2">
                            Cruise Packages
                        </h3>
                        <p class="text-gray-700">
                            Explore luxury cruise holidays with up to 25% off
                            package deals.
                        </p>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-blue-900 mb-2">
                            Cancellation Support
                        </h3>
                        <p class="text-gray-700">
                            Get expert assistance with flight and hotel
                            cancellations 24/7.
                        </p>
                    </div>
                </div>

                <!-- FAQ -->

                <div class="mt-10">
                    <h2 class="text-3xl font-bold text-blue-900 mb-6">
                        Frequently Asked Questions
                    </h2>
                    <div class="space-y-4">
                        <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
                            <summary class="font-bold text-blue-900 text-lg">
                                What are your business hours?
                            </summary>
                            <p class="text-gray-700 mt-4">
                                We operate 24/7 to assist you with all your
                                travel needs. Our support team is always
                                available!
                            </p>
                        </details>
                        <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
                            <summary class="font-bold text-blue-900 text-lg">
                                How quickly can I get a response?
                            </summary>
                            <p class="text-gray-700 mt-4">
                                Phone and WhatsApp: Immediate response. Email:
                                Within 24 hours. For urgent matters, please call
                                us directly.
                            </p>
                        </details>
                        <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
                            <summary class="font-bold text-blue-900 text-lg">
                                Do you handle cancellations?
                            </summary>
                            <p class="text-gray-700 mt-4">
                                Yes! We specialize in helping customers with
                                flight and hotel cancellations. Call us for
                                assistance.
                            </p>
                        </details>
                        <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
                            <summary class="font-bold text-blue-900 text-lg">
                                What payment methods do you accept?
                            </summary>
                            <p class="text-gray-700 mt-4">
                                We accept all major credit cards, debit cards,
                                and various online payment methods. Details
                                available during booking.
                            </p>
                        </details>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
