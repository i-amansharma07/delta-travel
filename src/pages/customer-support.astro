---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingForm from "../components/BookingForm.astro";
---

<Layout title="24/7 Customer Support & Cancellation Help - Delta Air Travel">
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="relative bg-slate-900 text-white overflow-hidden">
            <div class="absolute inset-0 opacity-30">
                <img
                    src="/images/support-team.jpg"
                    alt="Support team"
                    class="w-full h-full object-cover"
                />
            </div>
            <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/80 to-slate-900/40"></div>

            <div class="relative z-10 max-w-container mx-auto px-4 py-section-lg text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">
                    24/7 Customer Support
                </h1>
                <p class="text-xl text-slate-200 mb-4">
                    Expert assistance for cancellations and changes
                </p>
                <div class="inline-block bg-accent-500/10 border border-accent-500/30 rounded-lg px-4 py-2">
                    <span class="text-accent-400 font-semibold">
                        ✓ Immediate response guaranteed
                    </span>
                </div>
            </div>
        </section>

        <!-- Contact Methods -->
        <section class="py-section-lg px-4 bg-slate-50">
            <div class="max-w-container mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12 text-center">
                    Reach Us Anytime
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="bg-white border border-slate-200 rounded-xl p-8 text-center hover:shadow-md transition">
                        <div class="text-5xl mb-4">📞</div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">
                            Phone Support
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Call us anytime, day or night
                        </p>
                        <a
                            href={`tel:${'+1 800 258 1388'.replace(/\s/g, '')}`}
                            class="text-accent-600 font-semibold hover:text-accent-700"
                        >
                            +1 800 258 1388
                        </a>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-xl p-8 text-center hover:shadow-md transition">
                        <div class="text-5xl mb-4">💬</div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">
                            WhatsApp Chat
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Instant messaging with support agents
                        </p>
                        <a
                            href="https://wa.me/18555465052"
                            class="text-accent-600 font-semibold hover:text-accent-700"
                        >
                            Start Chat
                        </a>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-xl p-8 text-center hover:shadow-md transition">
                        <div class="text-5xl mb-4">✉️</div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">
                            Email Support
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Detailed assistance via email
                        </p>
                        <a
                            href="mailto:support@deltaairtravel.com"
                            class="text-accent-600 font-semibold hover:text-accent-700"
                        >
                            support@deltaairtravel.com
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Support Services -->
        <section class="py-section-lg px-4 bg-white">
            <div class="max-w-container mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12 text-center">
                    Our Support Services
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">✈️</div>
                        <h3 class="text-lg font-bold text-slate-900 mb-3">
                            Flight Cancellations
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Instant assistance with cancellations, rebooking,
                            and refunds for flights
                        </p>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">🏨</div>
                        <h3 class="text-lg font-bold text-slate-900 mb-3">
                            Hotel Changes
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Modify or cancel hotel reservations with minimal
                            penalty
                        </p>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">🚢</div>
                        <h3 class="text-lg font-bold text-slate-900 mb-3">
                            Cruise Support
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Expert help with cruise bookings and modifications
                        </p>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">🔄</div>
                        <h3 class="text-lg font-bold text-slate-900 mb-3">
                            Rebooking Services
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Rebook your travel quickly on alternative dates and
                            flights
                        </p>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">💰</div>
                        <h3 class="text-lg font-bold text-slate-900 mb-3">
                            Refund Processing
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Fast refunds processed to your original payment
                            method
                        </p>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                        <div class="text-4xl mb-4">🆘</div>
                        <h3 class="text-lg font-bold text-slate-900 mb-3">
                            Emergency Assistance
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Priority support for travel emergencies and urgent
                            matters
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Support Request Form -->
        <section class="py-section-lg px-4 bg-slate-50">
            <BookingForm serviceType="cancellation" />
        </section>

        <!-- CTA Section -->
        <section class="py-section-lg px-4 bg-slate-900 text-white">
            <div class="max-w-container mx-auto text-center">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">
                    Need Help Right Now?
                </h2>
                <p class="text-lg text-slate-200 mb-8">
                    Our team is available 24/7 to assist you
                </p>
                <a
                    href={`tel:${'+1 800 258 1388'.replace(/\s/g, '')}`}
                    class="inline-block bg-accent-600 hover:bg-accent-700 text-white font-semibold px-8 py-3 rounded-lg transition"
                >
                    Call Us Now
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
