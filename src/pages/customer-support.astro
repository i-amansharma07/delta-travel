---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Layout title="Customer Support - Delta Air Travel">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Cancellation Support</h1>
        <p class="text-xl text-blue-100">24/7 Expert Help for Flight & Hotel Cancellations</p>
      </div>
    </section>

    <!-- Service Card -->
    <section class="py-8 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-6 shadow-md mb-8">
          <div>
            <h2 class="text-2xl font-bold text-blue-900">Cancellation Support</h2>
            <p class="text-gray-700 mt-2">Need to cancel or modify your booking? Our expert team is here to help you navigate the process and get the best possible outcome.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Form -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <BookingForm serviceType="cancellation" />
      </div>
    </section>

    <!-- Our Expertise -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">Why Choose Our Cancellation Support?</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-blue-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold text-blue-900 mb-3">📞 24/7 Availability</h3>
            <p class="text-gray-700">Our support team is available round the clock to assist with cancellations anytime.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold text-blue-900 mb-3">💼 Expert Knowledge</h3>
            <p class="text-gray-700">Over 15 years of experience navigating complex airline and hotel policies.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold text-blue-900 mb-3">💰 Maximum Refunds</h3>
            <p class="text-gray-700">We fight to get you the best refund possible under applicable policies.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold text-blue-900 mb-3">⚡ Fast Processing</h3>
            <p class="text-gray-700">Quick cancellation processing and rapid refund handling.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold text-blue-900 mb-3">📋 Policy Expertise</h3>
            <p class="text-gray-700">Deep understanding of airline and hotel cancellation policies worldwide.</p>
          </div>
          <div class="bg-blue-50 p-6 rounded-lg">
            <h3 class="text-xl font-bold text-blue-900 mb-3">✓ Hassle-Free</h3>
            <p class="text-gray-700">Let us handle all the complexity while you relax.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services We Handle -->
    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-blue-900 mb-8 text-center">Services We Handle</h2>
        <div class="space-y-4">
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">✈️ Flight Cancellations</h3>
            <p class="text-gray-700">Help with cancelling flights and getting refunds or travel credits.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🏨 Hotel Cancellations</h3>
            <p class="text-gray-700">Assistance with hotel reservations and cancellation requests.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">✏️ Booking Modifications</h3>
            <p class="text-gray-700">Change dates, passengers, or destinations on existing bookings.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🔄 Rebooking Services</h3>
            <p class="text-gray-700">Rebook on alternative flights or dates that work better for you.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">📋 Refund Appeals</h3>
            <p class="text-gray-700">File appeals and claims for denied refunds with airlines and hotels.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
            <h3 class="text-xl font-bold text-blue-900 mb-2">🆘 Emergency Assistance</h3>
            <p class="text-gray-700">Urgent help with last-minute changes and emergency situations.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-12 px-4 bg-blue-900 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-6">Need Immediate Help?</h2>
        <p class="text-xl text-blue-100 mb-8">Call our support team right now</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <a href="tel:+18555465052" class="bg-white text-blue-900 px-8 py-4 rounded-lg hover:bg-blue-100 transition-colors font-bold text-lg inline-block">
            📞 +1 (855) 546-5052
          </a>
          <a href="https://wa.me/18555465052" class="bg-white text-blue-900 px-8 py-4 rounded-lg hover:bg-blue-100 transition-colors font-bold text-lg inline-block">
            💬 WhatsApp Support
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
