---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us - Delta Air Travel">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
        <p class="text-xl text-blue-100">We're Here to Help 24/7</p>
      </div>
    </section>

    <!-- Contact Information -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          <!-- Phone -->
          <div class="bg-blue-50 p-8 rounded-lg text-center">
            <div class="text-4xl mb-4">📞</div>
            <h3 class="text-xl font-bold text-blue-900 mb-4">Call Us</h3>
            <p class="text-gray-700 mb-3">
              <a href="tel:+18555465052" class="text-blue-600 hover:text-blue-800 font-semibold">+1 (855) 546-5052</a>
            </p>
            <p class="text-gray-700">
              <a href="tel:+18887380967" class="text-blue-600 hover:text-blue-800 font-semibold">+1 (888) 738-0967</a>
            </p>
            <p class="text-gray-600 text-sm mt-3">Available 24/7</p>
          </div>

          <!-- Email -->
          <div class="bg-blue-50 p-8 rounded-lg text-center">
            <div class="text-4xl mb-4">✉️</div>
            <h3 class="text-xl font-bold text-blue-900 mb-4">Email Us</h3>
            <p class="text-gray-700 mb-3">
              <a href="mailto:info@deltaairtravel.com" class="text-blue-600 hover:text-blue-800 font-semibold">info@deltaairtravel.com</a>
            </p>
            <p class="text-gray-600 text-sm mt-3">Response within 24 hours</p>
          </div>

          <!-- WhatsApp -->
          <div class="bg-blue-50 p-8 rounded-lg text-center">
            <div class="text-4xl mb-4">💬</div>
            <h3 class="text-xl font-bold text-blue-900 mb-4">WhatsApp</h3>
            <p class="text-gray-700 mb-3">
              <a href="https://wa.me/18555465052" class="text-blue-600 hover:text-blue-800 font-semibold">Message Us</a>
            </p>
            <p class="text-gray-600 text-sm mt-3">Instant messaging support</p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-gray-50 p-8 rounded-lg mb-12">
          <h2 class="text-3xl font-bold text-blue-900 mb-6">Send us a Message</h2>
          <form class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-gray-700 font-medium mb-2">Name</label>
                <input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your Name" />
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-2">Email</label>
                <input type="email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your Email" />
              </div>
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">Subject</label>
              <input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="What is this about?" />
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">Message</label>
              <textarea class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" rows="5" placeholder="Your message..."></textarea>
            </div>
            <button type="submit" class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold">
              Send Message
            </button>
          </form>
        </div>

        <!-- FAQ -->
        <div>
          <h2 class="text-3xl font-bold text-blue-900 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
              <summary class="font-bold text-blue-900 text-lg">What are your business hours?</summary>
              <p class="text-gray-700 mt-4">We operate 24/7 to assist you with all your travel needs. Our support team is always available!</p>
            </details>
            <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
              <summary class="font-bold text-blue-900 text-lg">How quickly can I get a response?</summary>
              <p class="text-gray-700 mt-4">Phone and WhatsApp: Immediate response. Email: Within 24 hours. For urgent matters, please call us directly.</p>
            </details>
            <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
              <summary class="font-bold text-blue-900 text-lg">Do you handle cancellations?</summary>
              <p class="text-gray-700 mt-4">Yes! We specialize in helping customers with flight and hotel cancellations. Call us for assistance.</p>
            </details>
            <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
              <summary class="font-bold text-blue-900 text-lg">What payment methods do you accept?</summary>
              <p class="text-gray-700 mt-4">We accept all major credit cards, debit cards, and various online payment methods. Details available during booking.</p>
            </details>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
