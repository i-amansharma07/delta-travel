---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { contactUsConstants } from "../constants/contact_us_constants";
---

<Layout title="Contact Us - Delta Air Travel">
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
            <div class="max-w-7xl mx-auto text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">
                    {contactUsConstants.hero.title}
                </h1>
                <p class="text-xl text-blue-100">{contactUsConstants.hero.subtitle}</p>
            </div>
        </section>

        <!-- Contact Information -->
        <section class="py-12 px-4 bg-white">
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
                    <!-- Phone -->
                    <div class="bg-blue-50 p-8 rounded-lg text-center">
                        <div class="text-4xl mb-4">{contactUsConstants.contactInfo.phone.icon}</div>
                        <h3 class="text-xl font-bold text-blue-900 mb-4">
                            {contactUsConstants.contactInfo.phone.heading}
                        </h3>
                        {contactUsConstants.contactInfo.phone.numbers.map((num) => (
                            <p class="text-gray-700 mb-3">
                                <a href={`tel:${num.replace(/\s/g, '')}`} class="text-blue-600 hover:text-blue-800 font-semibold">
                                    {num}
                                </a>
                            </p>
                        ))}
                        <p class="text-gray-600 text-sm mt-3">
                            {contactUsConstants.contactInfo.phone.availability}
                        </p>
                    </div>

                    <!-- Email -->
                    <div class="bg-blue-50 p-8 rounded-lg text-center">
                        <div class="text-4xl mb-4">{contactUsConstants.contactInfo.email.icon}</div>
                        <h3 class="text-xl font-bold text-blue-900 mb-4">
                            {contactUsConstants.contactInfo.email.heading}
                        </h3>
                        <p class="text-gray-700 mb-3">
                            <a href={contactUsConstants.contactInfo.email.href} class="text-blue-600 hover:text-blue-800 font-semibold">
                                {contactUsConstants.contactInfo.email.address}
                            </a>
                        </p>
                        <p class="text-gray-600 text-sm mt-3">
                            {contactUsConstants.contactInfo.email.response}
                        </p>
                    </div>

                    <!-- WhatsApp -->
                    <div class="bg-blue-50 p-8 rounded-lg text-center">
                        <div class="text-4xl mb-4">{contactUsConstants.contactInfo.whatsapp.icon}</div>
                        <h3 class="text-xl font-bold text-blue-900 mb-4">
                            {contactUsConstants.contactInfo.whatsapp.heading}
                        </h3>
                        <p class="text-gray-700 mb-3">
                            <a href={contactUsConstants.contactInfo.whatsapp.href} class="text-blue-600 hover:text-blue-800 font-semibold">
                                {contactUsConstants.contactInfo.whatsapp.action}
                            </a>
                        </p>
                        <p class="text-gray-600 text-sm mt-3">
                            {contactUsConstants.contactInfo.whatsapp.response}
                        </p>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="bg-gray-50 p-8 rounded-lg mb-12">
                    <h2 class="text-3xl font-bold text-blue-900 mb-6">
                        {contactUsConstants.contactForm.heading}
                    </h2>
                    <form class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-gray-700 font-medium mb-2">
                                    {contactUsConstants.contactForm.fields.name.label}
                                </label>
                                <input
                                    type="text"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                    placeholder={contactUsConstants.contactForm.fields.name.placeholder}
                                />
                            </div>
                            <div>
                                <label class="block text-gray-700 font-medium mb-2">
                                    {contactUsConstants.contactForm.fields.email.label}
                                </label>
                                <input
                                    type="email"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                    placeholder={contactUsConstants.contactForm.fields.email.placeholder}
                                />
                            </div>
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">
                                {contactUsConstants.contactForm.fields.subject.label}
                            </label>
                            <input
                                type="text"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                placeholder={contactUsConstants.contactForm.fields.subject.placeholder}
                            />
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">
                                {contactUsConstants.contactForm.fields.message.label}
                            </label>
                            <textarea
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                rows={contactUsConstants.contactForm.fields.message.rows}
                                placeholder={contactUsConstants.contactForm.fields.message.placeholder}
                            ></textarea>
                        </div>
                        <button
                            type="submit"
                            class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold"
                        >
                            {contactUsConstants.contactForm.submitButton}
                        </button>
                    </form>
                </div>

                <!-- FAQ -->
                <div>
                    <h2 class="text-3xl font-bold text-blue-900 mb-6">
                        {contactUsConstants.faq.heading}
                    </h2>
                    <div class="space-y-4">
                        {contactUsConstants.faq.questions.map((faq) => (
                            <details class="bg-white border border-gray-200 rounded-lg p-6 cursor-pointer">
                                <summary class="font-bold text-blue-900 text-lg">
                                    {faq.question}
                                </summary>
                                <p class="text-gray-700 mt-4">
                                    {faq.answer}
                                </p>
                            </details>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>