---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import BookingForm from "../components/BookingForm.astro";
import ServiceFeatures from "../components/ServiceFeatures.astro";
import Testimonials from "../components/Testimonials.astro";
import { homePageConstants } from "../constants/home_page_constants";
---

<Layout title="Delta Air Travel - Book Flights, Hotels & Cruises">
    <Header />

    <main>
        {/* Hero Section */}
        <Hero />

        {/* Flight Booking Section */}
        <section id="flights" class="py-section-lg px-4 bg-white">
            <BookingForm serviceType="flight" />
        </section>

        {/* Trust & Credibility Section */}
        <section class="py-section-lg px-4 bg-slate-50">
            <div class="max-w-container mx-auto">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
                        {homePageConstants.whyChooseUs.title}
                    </h2>
                    <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                        {homePageConstants.whyChooseUs.subtitle}
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {homePageConstants.whyChooseUs.cards.map((card) => (
                        <div class="bg-white border border-slate-200 rounded-xl p-8 hover:shadow-md transition">
                            <div class="text-4xl mb-4">{card.emoji}</div>
                            <h3 class="text-xl font-bold text-slate-900 mb-3">
                                {card.title}
                            </h3>
                            <p class="text-slate-600">
                                {card.description}
                            </p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* Hotel Booking Section */}
        <section id="hotels" class="py-section-lg px-4 bg-white">
            <BookingForm serviceType="hotel" />
        </section>

        {/* Service Comparison */}
        <section class="py-section-lg px-4 bg-slate-50">
            <div class="max-w-container mx-auto">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
                        {homePageConstants.services.title}
                    </h2>
                    <p class="text-lg text-slate-600">
                        {homePageConstants.services.subtitle}
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {homePageConstants.services.cards.map((card) => (
                        <div class="bg-white rounded-xl overflow-hidden border border-slate-200 hover:shadow-lg transition">
                            <div class="h-40 bg-gradient-to-br from-slate-900 to-slate-800 flex items-center justify-center text-5xl">
                                {card.emoji}
                            </div>
                            <div class="p-8">
                                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                                    {card.title}
                                </h3>
                                <p class="text-slate-600 mb-4">
                                    {card.description}
                                </p>
                                <ul class="space-y-2 text-sm text-slate-700 mb-6">
                                    {card.features.map((feature) => (
                                        <li>{feature}</li>
                                    ))}
                                </ul>
                                <a
                                    href={card.buttonHref}
                                    class="inline-block bg-accent-600 text-white px-6 py-2 rounded-lg hover:bg-accent-700 transition font-medium text-sm"
                                >
                                    {card.buttonText}
                                </a>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* Cruise Booking Section */}
        <section id="cruises" class="py-section-lg px-4 bg-white">
            <BookingForm serviceType="cruise" />
        </section>

        {/* How It Works */}
        <section class="py-section-lg px-4 bg-slate-50">
            <div class="max-w-container mx-auto">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
                        {homePageConstants.bookingProcess.title}
                    </h2>
                    <p class="text-lg text-slate-600">
                        {homePageConstants.bookingProcess.subtitle}
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    {homePageConstants.bookingProcess.steps.map((step) => (
                        <div class="text-center">
                            <div class="inline-flex items-center justify-center w-16 h-16 bg-accent-600 text-white rounded-full font-bold text-xl mb-4">
                                {step.number}
                            </div>
                            <h3 class="text-lg font-bold text-slate-900 mb-2">
                                {step.title}
                            </h3>
                            <p class="text-slate-600 text-sm">
                                {step.description}
                            </p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* Cancellation Support Section */}
        <section id="cancellation" class="py-section-lg px-4 bg-white">
            <BookingForm serviceType="cancellation" />
        </section>

        {/* Service Features Section */}
        <ServiceFeatures />

        {/* Testimonials Section */}
        <Testimonials />

        {/* CTA Section */}
        <section class="py-section-lg px-4 bg-slate-900 text-white">
            <div class="max-w-container mx-auto text-center">
                <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
                    {homePageConstants.cta.title}
                </h2>
                <p class="text-lg text-slate-200 mb-8 max-w-2xl mx-auto">
                    {homePageConstants.cta.subtitle}
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a
                        href={homePageConstants.cta.buttons.getQuoteHref}
                        class="inline-block bg-accent-600 hover:bg-accent-700 text-white font-semibold px-8 py-3 rounded-lg transition-colors"
                    >
                        {homePageConstants.cta.buttons.getQuote}
                    </a>
                    <a
                        href={homePageConstants.cta.buttons.callUsHref}
                        class="inline-block bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3 rounded-lg transition-colors border border-white/20"
                    >
                        {homePageConstants.cta.buttons.callUs}
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
