---
import { features } from '../data/features';
---

<section class="bg-gray-50 py-12 px-4">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">Why Choose Us?</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">
            {feature.title === 'Easy Booking' && '✈️'}
            {feature.title === 'Quick Refund' && '💰'}
            {feature.title === 'Cancellation Support' && '🆘'}
            {feature.title === 'Hotel & Cruise' && '🏨'}
          </div>
          <h3 class="text-xl font-bold text-blue-900 mb-2">{feature.title}</h3>
          <p class="text-gray-600">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
