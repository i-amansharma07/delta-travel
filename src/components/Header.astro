<header class="sticky top-0 z-50 bg-white shadow-md">
  <!-- Top navigation bar -->
  <div class="bg-blue-900 text-white px-4 py-2">
    <div class="max-w-7xl mx-auto flex justify-between items-center text-sm">
      <div class="flex gap-4">
        <span>Welcome to Delta Air Travel</span>
      </div>
      <a href="tel:+18555465052" class="hover:text-blue-200">
        +1 (855) 546-5052
      </a>
    </div>
  </div>

  <!-- Main navigation bar -->
  <nav class="bg-white px-4 py-4">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="text-2xl font-bold text-blue-900">
        Delta Air Travel
      </div>

      <ul class="hidden md:flex gap-8 items-center text-gray-700">
        <li>
          <a href="/" class="hover:text-blue-600 transition">Home</a>
        </li>
        <li>
          <a href="/about-us" class="hover:text-blue-600 transition">About Us</a>
        </li>
        <li class="relative group">
          <a href="#services" class="hover:text-blue-600 transition">Services ▼</a>
