            <a href="/customer-support" class="block px-4 py-2 hover:bg-blue-100">Cancellation Support</a>
          </div>
        </li>
        <li>
          <a href="/blog" class="hover:text-blue-600 transition">Blog</a>
        </li>
        <li>
          <a href="/contact-us" class="hover:text-blue-600 transition">Contact Us</a>
        </li>
      </ul>

      <a href="tel:+18555465052" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium">
        +1 (855) 546-5052
      </a>
    </div>
