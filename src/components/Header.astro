          <div class="absolute left-0 top-full w-48 h-2"></div>
          <div class="absolute left-0 top-full mt-2 w-48 bg-white shadow-lg rounded-lg py-2 hidden group-hover:block">
            <a href="/flight-booking" class="block px-4 py-2 hover:bg-blue-100">Flight Booking</a>
            <a href="/hotel-booking" class="block px-4 py-2 hover:bg-blue-100">Hotel Booking</a>
