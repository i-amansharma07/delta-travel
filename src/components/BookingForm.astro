---
import { bookingFormConstants } from '../constants/booking_form_constants';

interface Props {
  serviceType: 'flight' | 'hotel' | 'cruise' | 'cancellation';
}

const { serviceType } = Astro.props;
const config = bookingFormConstants.formConfig[serviceType];
---

<section id={`${serviceType}-form`} class="py-section-lg px-4">
  <div class="max-w-container mx-auto">
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">{config.icon}</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900">{config.title}</h2>
      </div>
      <p class="text-lg text-slate-600">{config.description}</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Form Column -->
      <div class="lg:col-span-2">
        <form class="booking-form bg-white rounded-xl shadow-md border border-slate-200 p-6 md:p-8" data-service-type={serviceType}>
          <!-- Error Messages -->
          <div class="form-errors mb-6 hidden">
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
              <p class="text-red-900 font-semibold mb-2">Please fix the following errors:</p>
              <ul class="errors-list text-red-700 space-y-1 list-disc list-inside text-sm"></ul>
            </div>
          </div>

          <!-- Success Message -->
          <div class="form-success mb-6 hidden">
            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
              <p class="text-green-900 font-semibold">✓ Booking submitted successfully!</p>
              <p class="text-green-700 text-sm mt-2">Check your email for confirmation. Our team will contact you within 2 hours.</p>
            </div>
          </div>

          <!-- Trip Details -->
          <fieldset class="mb-8">
            <legend class="text-sm font-semibold text-slate-900 mb-4 uppercase tracking-wide">Trip Details</legend>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Trip Type <span class="text-red-500">*</span></label>
                <select
                  name="tripType"
                  class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900 bg-white"
                  required
                >
                  <option value="">-- Select Trip Type --</option>
                  <option value="One Way">One Way</option>
                  <option value="Round Trip">Round Trip</option>
                  <option value="Multi-City">Multi-City</option>
                </select>
                <span class="error-message text-red-500 text-xs hidden mt-1"></span>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Passengers <span class="text-red-500">*</span></label>
                <select
                  name="passengers"
                  class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900 bg-white"
                  required
                >
                  <option value="">-- Select Passengers --</option>
                  <option value="1">1 Passenger</option>
                  <option value="2">2 Passengers</option>
                  <option value="3">3 Passengers</option>
                  <option value="4">4 Passengers</option>
                  <option value="5">5+ Passengers</option>
                </select>
                <span class="error-message text-red-500 text-xs hidden mt-1"></span>
              </div>
            </div>
          </fieldset>

          <!-- Route Information -->
          <fieldset class="mb-8">
            <legend class="text-sm font-semibold text-slate-900 mb-4 uppercase tracking-wide">Route Information</legend>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">From <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  name="from"
                  placeholder="e.g. New York, USA"
                  class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900"
                  required
                />
                <span class="error-message text-red-500 text-xs hidden mt-1"></span>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">To <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  name="to"
                  placeholder="e.g. Los Angeles, USA"
                  class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900"
                  required
                />
                <span class="error-message text-red-500 text-xs hidden mt-1"></span>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Departure Date <span class="text-red-500">*</span></label>
                <input
                  type="date"
                  name="departureDate"
                  class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900"
                  required
                />
                <span class="error-message text-red-500 text-xs hidden mt-1"></span>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Return Date (if applicable)</label>
                <input
                  type="date"
                  name="returnDate"
                  class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900"
                />
                <span class="error-message text-red-500 text-xs hidden mt-1"></span>
              </div>
            </div>
          </fieldset>

          <!-- Contact Information -->
          <fieldset class="mb-8">
            <legend class="text-sm font-semibold text-slate-900 mb-4 uppercase tracking-wide">Your Contact Information</legend>
            <div class="grid grid-cols-1 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Full Name <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  name="name"
                  placeholder="Your full name"
                  class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900"
                  required
                />
                <span class="error-message text-red-500 text-xs hidden mt-1"></span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-2">Email <span class="text-red-500">*</span></label>
                  <input
                    type="email"
                    name="email"
                    placeholder="your-email@example.com"
                    class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900"
                    required
                  />
                  <span class="error-message text-red-500 text-xs hidden mt-1"></span>
                </div>

                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-2">WhatsApp <span class="text-red-500">*</span></label>
                  <input
                    type="tel"
                    name="whatsapp"
                    placeholder="+1 (555) 000-0000"
                    class="form-input w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent text-slate-900"
                    required
                  />
                  <span class="error-message text-red-500 text-xs hidden mt-1"></span>
                </div>
              </div>
            </div>
          </fieldset>

          <!-- Submit Button -->
          <button
            type="submit"
            class="submit-btn w-full bg-accent-600 hover:bg-accent-700 text-white font-semibold py-3 rounded-lg transition-colors disabled:bg-slate-400 disabled:cursor-not-allowed text-base"
          >
            Get Your Quote
          </button>

          <p class="text-xs text-slate-500 text-center mt-4">
            ✓ Secure booking • ✓ No payment required • ✓ Instant confirmation
          </p>
        </form>
      </div>

      <!-- Benefits Column -->
      <div class="lg:col-span-1">
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 h-fit sticky top-24">
          <h3 class="text-lg font-bold text-slate-900 mb-6">Why Book With Us?</h3>

          <div class="space-y-5">
            <div class="flex gap-3">
              <div class="flex-shrink-0 text-xl">✓</div>
              <div>
                <p class="font-medium text-slate-900 text-sm">Best Prices Guaranteed</p>
                <p class="text-slate-600 text-xs">Price match on all bookings</p>
              </div>
            </div>

            <div class="flex gap-3">
              <div class="flex-shrink-0 text-xl">✓</div>
              <div>
                <p class="font-medium text-slate-900 text-sm">24/7 Support Available</p>
                <p class="text-slate-600 text-xs">Expert assistance anytime</p>
              </div>
            </div>

            <div class="flex gap-3">
              <div class="flex-shrink-0 text-xl">✓</div>
              <div>
                <p class="font-medium text-slate-900 text-sm">Flexible Cancellation</p>
                <p class="text-slate-600 text-xs">Free changes up to 24hrs</p>
              </div>
            </div>

            <div class="flex gap-3">
              <div class="flex-shrink-0 text-xl">✓</div>
              <div>
                <p class="font-medium text-slate-900 text-sm">Secure Booking</p>
                <p class="text-slate-600 text-xs">SSL encrypted transactions</p>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-200">
            <p class="text-xs text-slate-600 mb-3">Questions? Call us anytime</p>
            <a href={`tel:${'+1 800 258 1388'.replace(/\s/g, '')}`} class="text-accent-600 font-semibold hover:text-accent-700">
              +1 800 258 1388
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.booking-form');

    forms.forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const errorDiv = form.querySelector('.form-errors');
        const successDiv = form.querySelector('.form-success');
        const errorsList = form.querySelector('.errors-list');

        errorDiv?.classList.add('hidden');
        successDiv?.classList.add('hidden');

        const formData = new FormData(form);
        const errors: string[] = [];

        const name = formData.get('name') as string;
        const email = formData.get('email') as string;
        const whatsapp = formData.get('whatsapp') as string;
        const from = formData.get('from') as string;
        const to = formData.get('to') as string;
        const departureDate = formData.get('departureDate') as string;
        const passengers = formData.get('passengers') as string;

        if (!name?.trim()) errors.push('Name is required');
        if (!email?.trim()) errors.push('Email is required');
        if (!whatsapp?.trim()) errors.push('WhatsApp number is required');
        if (!from?.trim()) errors.push('Departure location is required');
        if (!to?.trim()) errors.push('Destination is required');
        if (!departureDate) errors.push('Departure date is required');
        if (!passengers) errors.push('Number of passengers is required');

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (email && !emailRegex.test(email)) {
          errors.push('Please enter a valid email address');
        }

        const phoneRegex = /^\+?[\d\s\-\(\)]{10,}$/;
        if (whatsapp && !phoneRegex.test(whatsapp)) {
          errors.push('Please enter a valid phone number');
        }

        if (errors.length > 0) {
          errorsList!.innerHTML = errors.map((err) => `<li>${err}</li>`).join('');
          errorDiv?.classList.remove('hidden');
          return;
        }

        const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Processing...';

        try {
          const response = await fetch('/api/submit-booking', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              serviceType: form.dataset.serviceType,
              tripType: formData.get('tripType'),
              from,
              to,
              departureDate,
              returnDate: formData.get('returnDate') || '',
              passengers,
              name,
              whatsapp,
              email,
            }),
          });

          const result = await response.json();

          if (result.success) {
            successDiv?.classList.remove('hidden');
            form.reset();
            successDiv?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            errorsList!.innerHTML = (result.errors || ['An error occurred']).map((err: string) => `<li>${err}</li>`).join('');
            errorDiv?.classList.remove('hidden');
          }
        } catch (error) {
          errorsList!.innerHTML = `<li>An error occurred. Please try again or call us at <a href="tel:${'+1 800 258 1388'.replace(/\s/g, '')}" class="text-accent-600 font-semibold hover:text-accent-700">${'+1 800 258 1388'.replace(/\s/g, '')}</a></li>`;
          errorDiv?.classList.remove('hidden');
          console.error('Booking submission error:', error);
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    });
  });
</script>

