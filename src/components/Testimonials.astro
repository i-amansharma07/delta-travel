---
import { testimonials } from '../data/testimonials';
---

<section class="py-12 px-4 bg-white">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">What Our Customers Say</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((testimonial) => (
        <div class="bg-blue-50 p-6 rounded-lg shadow-md border-l-4 border-blue-600">
          <p class="text-gray-700 mb-4 italic">"{testimonial.text}"</p>
          <p class="font-bold text-blue-900">- {testimonial.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>
