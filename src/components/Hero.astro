---
import { services } from '../data/services';
---

<section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white py-16 px-4">
  <div class="max-w-7xl mx-auto text-center mb-12">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Your Trusted Travel Partner</h1>
    <p class="text-xl text-blue-100">Book Flights, Hotels, and Cruises with Confidence</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {services.map((service) => (
      <div class="bg-white/10 backdrop-blur-sm p-6 rounded-lg hover:bg-white/20 transition-all">
        <h3 class="text-2xl font-bold mb-3">{service.title}</h3>
        <p class="text-blue-100 mb-4">{service.description}</p>
        <a
          href={`tel:${service.phoneNumber}`}
          class="inline-block bg-white text-blue-900 px-4 py-2 rounded-lg hover:bg-blue-100 transition-colors font-semibold"
        >
          {service.phoneNumber}
        </a>
      </div>
    ))}
  </div>
</section>
