---
---

<footer class="bg-slate-900 text-slate-100 mt-section-xl">
  <div class="max-w-container mx-auto px-4 py-section-lg">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand Column -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl">✈️</span>
          <h3 class="text-lg font-bold text-white">Delta Air Travel</h3>
        </div>
        <p class="text-slate-400 text-sm mb-4">
          Your trusted travel partner for flights, hotels, and cruises worldwide.
        </p>
        <div class="flex gap-3">
          <!-- Facebook -->
          <a
            href="https://facebook.com/deltaairtravel"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on Facebook"
            class="group relative w-10 h-10 rounded-full bg-gradient-to-br from-slate-700 to-slate-800 hover:from-blue-600 hover:to-blue-700 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-blue-500/30"
          >
            <svg class="w-5 h-5 text-white group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- X (Twitter) -->
          <a
            href="https://x.com/deltaairtravel"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on X"
            class="group relative w-10 h-10 rounded-full bg-gradient-to-br from-slate-700 to-slate-800 hover:from-black hover:to-gray-800 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-black/30"
          >
            <svg class="w-5 h-5 text-white group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.6l-5.165-6.75-5.904 6.75h-3.315l7.73-8.835L2.42 2.25h6.6l4.759 6.287L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com/deltaairtravel"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on Instagram"
            class="group relative w-10 h-10 rounded-full bg-gradient-to-br from-slate-700 to-slate-800 hover:from-pink-500 hover:via-red-500 hover:to-yellow-500 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-pink-500/30"
          >
            <svg class="w-5 h-5 text-white group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.372 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2.25c5.385 0 9.75 4.365 9.75 9.75S17.385 21.75 12 21.75 2.25 17.385 2.25 12 6.615 2.25 12 2.25zm0 1.5c-4.557 0-8.25 3.693-8.25 8.25s3.693 8.25 8.25 8.25 8.25-3.693 8.25-8.25-3.693-8.25-8.25-8.25zm0 1.5c3.728 0 6.75 3.022 6.75 6.75s-3.022 6.75-6.75 6.75-6.75-3.022-6.75-6.75 3.022-6.75 6.75-6.75zm3.75-1.5a1.125 1.125 0 100 2.25 1.125 1.125 0 000-2.25z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-bold text-white mb-4 uppercase tracking-wide">Quick Links</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/" class="text-slate-400 hover:text-accent-400 transition">Home</a>
          </li>
          <li>
            <a href="/about-us" class="text-slate-400 hover:text-accent-400 transition">About Us</a>
          </li>
          <li>
            <a href="/blog" class="text-slate-400 hover:text-accent-400 transition">Blog & Tips</a>
          </li>
          <li>
            <a href="/contact-us" class="text-slate-400 hover:text-accent-400 transition">Contact</a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm font-bold text-white mb-4 uppercase tracking-wide">Services</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/flight-booking" class="text-slate-400 hover:text-accent-400 transition">✈️ Flight Booking</a>
          </li>
          <li>
            <a href="/hotel-booking" class="text-slate-400 hover:text-accent-400 transition">🏨 Hotel Booking</a>
          </li>
          <li>
            <a href="/cruise-booking" class="text-slate-400 hover:text-accent-400 transition">🚢 Cruise Packages</a>
          </li>
          <li>
            <a href="/customer-support" class="text-slate-400 hover:text-accent-400 transition">💬 Support Services</a>
          </li>
        </ul>
      </div>

      <!-- Contact & Support -->
      <div>
        <h4 class="text-sm font-bold text-white mb-4 uppercase tracking-wide">Contact & Support</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="tel:+18555465052" class="text-slate-400 hover:text-accent-400 transition font-medium">
              📞 +1 (855) 546-5052
            </a>
          </li>
          <li>
            <a href="mailto:info@deltaairtravel.com" class="text-slate-400 hover:text-accent-400 transition">
              📧 info@deltaairtravel.com
            </a>
          </li>
          <li>
            <a href="https://wa.me/18555465052" class="text-slate-400 hover:text-accent-400 transition">
              💬 WhatsApp Support
            </a>
          </li>
          <li class="pt-2 border-t border-slate-800">
            <span class="text-slate-400">🟢 24/7 Available</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-slate-800 my-8"></div>

    <!-- Bottom Section with Trust & Legal -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Trust Indicators -->
      <div class="flex items-center gap-4 text-sm">
        <div class="text-2xl">🏆</div>
        <div>
          <p class="font-semibold text-white">15+ Years</p>
          <p class="text-slate-400">Trusted by travelers</p>
        </div>
      </div>

      <div class="flex items-center gap-4 text-sm">
        <div class="text-2xl">🔒</div>
        <div>
          <p class="font-semibold text-white">Secure</p>
          <p class="text-slate-400">SSL encrypted payments</p>
        </div>
      </div>

      <div class="flex items-center gap-4 text-sm">
        <div class="text-2xl">✓</div>
        <div>
          <p class="font-semibold text-white">Verified</p>
          <p class="text-slate-400">50K+ happy travelers</p>
        </div>
      </div>
    </div>

    <!-- Legal & Copyright -->
    <div class="border-t border-slate-800 pt-8">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-4">
        <div class="text-sm text-slate-400">
          &copy; 2026 Delta Air Travel. All rights reserved.
        </div>
        <div class="flex gap-6 text-sm">
          <a href="/privacy-policy" class="text-slate-400 hover:text-accent-400 transition">Privacy Policy</a>
          <a href="#terms" class="text-slate-400 hover:text-accent-400 transition">Terms & Conditions</a>
        </div>
      </div>
      <p class="text-xs text-slate-500 text-center">
        Delta Air Travel is a licensed travel service provider. All bookings are protected under IATA guidelines.
      </p>
    </div>
  </div>
</footer>

