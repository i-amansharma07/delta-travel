---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Delta Air Travel', description = 'Your trusted travel partner' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900">
    <slot />
  </body>
</html>
